# Cloudflare Pages/Workers — Headers para PWA correcta

# Permitir conexion a servidor local USB (mixed content exception para 127.0.0.1)
# y WebSocket seguro (wss:) para Supabase Realtime
#
# script-src: agregado 2026-08-23 -- antes la CSP solo restringía connect-src, así
# que un XSS (aunque ya se blindaron los que se encontraron esta sesión) podía
# cargar un <script src="https://dominio-malicioso"> sin ninguna barrera. Se agrega
# 'self' (scripts propios) + 'unsafe-inline' (obligatorio: TODA la UI usa
# onclick="..." inline, sin esto se rompe cada botón de la app) + jsdelivr
# (Chart.js, supabase-js -- ver admin-dashboard.js/admin-productos.js) + cdn.sheetjs.com
# (agregado el mismo día: XLSX se movió ahí porque la versión de npm/jsdelivr
# quedó congelada en 0.18.5, con una prototype pollution conocida al leer un
# archivo -- CVE-2023-30533 -- que sí importa acá porque admin-productos.js
# parsea el Excel que arrastra el usuario para importar productos).
# object-src/base-uri: sin costo funcional (sin Flash/plugins ni <base> en la app),
# cierran 2 vectores clásicos de bypass de CSP.
# frame-ancestors/X-Frame-Options: sin costo funcional (nada en la app se embebe
# vía iframe ni depende de que la sirvan embebida) -- cierran clickjacking.
# Strict-Transport-Security: Cloudflare Pages ya sirve todo por HTTPS; esto le
# dice al navegador que NUNCA intente HTTP para este dominio (sin includeSubDomains
# por las dudas de que exista algún subdominio con requisitos distintos).
/*
  Content-Security-Policy: connect-src 'self' https: wss: http://127.0.0.1:9200 http://127.0.0.1:8080; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdn.sheetjs.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: screen-wake-lock=(self)


# Service Workers — CRÍTICO: deben ser application/javascript
/sw.js
  Content-Type: application/javascript
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/sw-admin.js
  Content-Type: application/javascript
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/sw-superadmin.js
  Content-Type: application/javascript
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

# Manifests — deben ser application/manifest+json
/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/manifest-admin.json
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/manifest-superadmin.json
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# HTML — sin cache para que siempre estén frescos
/
  Cache-Control: no-cache, no-store, must-revalidate
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# JS modules — sin cache HTTP para que siempre traiga la última versión
/js/*.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript

# CSS — sin cache HTTP
/css/*.css
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/css

# Íconos — pueden cachearse
/icon*.png
  Cache-Control: public, max-age=86400
